# Public IPv4 players reach this relay on (sent to the patch in ALLOCATED). Required.
AC_RELAY_PUBLIC_IP=
# Optional: require this password (players put it in ac_relay.ini). Empty = open relay.
AC_RELAY_PASSWORD=
# Defaults; open both in the firewall (UDP).
AC_RELAY_CONTROL_PORT=21100
AC_RELAY_PORT_RANGE=40200-40999
AC_RELAY_BIND=0.0.0.0
AC_RELAY_LEASE=60
AC_RELAY_MAX_PER_IP=4
